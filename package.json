{
  "name": "aws-sdk-vitest-mock",
  "version": "1.0.99",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./vitest-setup": {
      "import": "./vitest-setup.js",
      "require": "./vitest-setup.cjs"
    }
  },
  "license": "MIT",
  "author": "sudokar",
  "scripts": {
    "ci": "bun install --frozen-lockfile",
    "prepare": "husky",
    "prepublishOnly": "HUSKY=0",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "test": "nx test",
    "build": "nx build",
    "docs": "node --import ./tools/typedoc-ts6-shim.mjs ./node_modules/.bin/typedoc && touch docs/.nojekyll",
    "docs:watch": "node --import ./tools/typedoc-ts6-shim.mjs ./node_modules/.bin/typedoc --watch",
    "docs:serve": "bun run docs && bunx http-server docs -o"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1096.0",
    "@aws-sdk/client-dynamodb": "3.1101.0",
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/lib-dynamodb": "3.1076.0",
    "@aws-sdk/types": "3.974.2",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@smithy/smithy-client": "^4.14.16",
    "@smithy/types": "4.16.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@types/node": "26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.0.2",
    "nx-oxlint": "^0.1.1",
    "oxlint": "^1.79.0",
    "prettier": "3.9.6",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@aws-sdk/core": "^3",
    "vitest": "^3 || ^4"
  }
}
